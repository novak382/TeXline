QPointF projected(const Scene &scene,const std::array<double,3> &v){const auto p=scene.axisX*v[0]+scene.axisY*v[1]+scene.axisZ*v[2];return {p.x()*scene.canvasScale.x(),p.y()*scene.canvasScale.y()};}
std::array<double,3> spatialPosition(const Scene &scene,int index,bool *ok){
  QSet<int> active;int steps=0;std::function<std::array<double,3>(int,bool &)> resolve=[&](int at,bool &valid)->std::array<double,3>{valid=false;if(at<0||at>=scene.items.size()||active.contains(at)||++steps>512)return {};active.insert(at);const auto &i=scene.items[at];const auto offset=i.shift+i.placementShift;if((i.kind==Kind::Point||i.kind==Kind::Node)&&(!finitePoint(offset)||std::hypot(offset.x(),offset.y())>1e-10)){active.remove(at);return {};}std::array<double,3> result{};if(i.coordinates.size()==1){const auto &c=i.coordinates[0];if(c.spatial){result=c.values;valid=true;}else if(!c.references.isEmpty()){QVector<std::array<double,3>> parents;bool all=true;for(const auto &name:c.references){int parent=-1;for(int n=0;n<scene.items.size();++n)if((scene.items[n].kind==Kind::Point||scene.items[n].kind==Kind::Node)&&scene.items[n].id==name){parent=n;break;}bool found=false;parents.append(resolve(parent,found));all&=found;}if(all){if(c.operation.isEmpty()&&parents.size()==1){result=parents[0];valid=true;}else if(c.operation==QStringLiteral("mix")&&parents.size()==2){for(int k=0;k<3;++k)result[k]=parents[0][k]+(parents[1][k]-parents[0][k])*c.fraction;valid=true;}else if(c.operation==QStringLiteral("add")&&parents.size()==3){for(int k=0;k<3;++k)result[k]=parents[0][k]+parents[1][k]-parents[2][k];valid=true;}}}}active.remove(at);return result;};bool valid=false;const auto result=resolve(index,valid);if(ok)*ok=valid;return result;
}
QString spatialCoordinates(const Scene &scene,int index,const std::array<double,3> &v){if(!scene.valid||!scene.coordinateSafe||index<0||index>=scene.items.size())return {};for(double n:v)if(!std::isfinite(n)||qAbs(n)>10000)return {};const auto &item=scene.items[index];if(item.kind==Kind::Ellipse&&item.coordinates.size()==1&&!item.coordinates[0].reference.isEmpty())for(int n=0;n<scene.items.size();++n)if(scene.items[n].kind==Kind::Point&&scene.items[n].id==item.coordinates[0].reference)return spatialCoordinates(scene,n,v);if(!item.movable||item.coordinates.size()!=1||!item.coordinates[0].spatial||!item.coordinates[0].curveFunctions.isEmpty())return {};const auto &c=item.coordinates[0];auto parts=scene.source.mid(c.start+1,c.end-c.start-2).split(QLatin1Char(','));if(parts.size()!=3)return {};for(int n=0;n<3;++n)if(qAbs(v[n]-c.values[n])>1e-12){const auto old=parts[n];int first=0,last=int(old.size());while(first<last&&old[first].isSpace())++first;while(last>first&&old[last-1].isSpace())--last;parts[n]=old.left(first)+number(v[n])+old.mid(last);}return patched(scene.source,{{{c.start,c.end,{}},QLatin1Char('(')+parts.join(QLatin1Char(','))+QLatin1Char(')')}});}
QString projectionView(const Scene &scene,double azimuth,double elevation,double unit){if(!scene.valid||!scene.coordinateSafe||!std::isfinite(azimuth)||!std::isfinite(elevation)||qAbs(azimuth)>360||qAbs(elevation)>89)return {};if(unit==0)unit=scene.spaceUnit;if(!std::isfinite(unit)||unit<.01||unit>100)return {};const double a=qDegreesToRadians(azimuth),e=qDegreesToRadians(elevation);const QPointF axes[3]{{-std::sin(a)*unit,-std::sin(e)*std::cos(a)*unit},{std::cos(a)*unit,-std::sin(e)*std::sin(a)*unit},{0,std::cos(e)*unit}};auto opts=scene.pictureOptions;for(int n=0;n<3;++n)opts=editOption(opts,n==0?QStringLiteral("x"):n==1?QStringLiteral("y"):QStringLiteral("z"),QStringLiteral("{(%1cm,%2cm)}").arg(number(axes[n].x()),number(axes[n].y())));QVector<QPair<Span,QString>> changes;changes.append({{scene.optionsStart>=0?scene.optionsStart:scene.insertOptions,scene.optionsStart>=0?scene.optionsEnd:scene.insertOptions,{}},QLatin1Char('[')+opts+QLatin1Char(']')});if(qAbs(unit-scene.spaceUnit)>1e-8)for(const auto &item:scene.items)if(item.spatial&&item.kind==Kind::Ellipse&&item.textStart<0&&item.radiusStart>=0){const double radius=item.size.width()/qAbs(scene.canvasScale.x())/2*unit/scene.spaceUnit;QString replacement;if(item.radiusAsOptions){const auto raw=scene.source.mid(item.radiusStart+1,item.radiusEnd-item.radiusStart-2);replacement=QLatin1Char('[')+editOption(raw,QStringLiteral("radius"),number(radius)+QStringLiteral("cm"))+QLatin1Char(']');}else replacement=QStringLiteral("(%1cm)").arg(number(radius));changes.append({{item.radiusStart,item.radiusEnd,{}},replacement});}return patched(scene.source,changes);}

QString spatialPoint(const Scene &scene,const std::array<double,3> &v,const QString &name){for(double n:v)if(!std::isfinite(n)||qAbs(n)>1000)return {};if(!scene.valid||!scene.coordinateSafe||scene.items.size()>450)return {};Scene base=scene;if(scene.items.isEmpty()){const auto source=projectionView(scene,-45,25,4);if(source.isEmpty())return {};base=parse(source,scene.styleContext);}QSet<QString> used;QString id=name.trimmed();if(id.isEmpty())id=freshName(base,used);else{if(!QRegularExpression(QStringLiteral(R"(^[A-Za-z][A-Za-z0-9_-]*$)")).match(id).hasMatch()||occupiedNames(base).contains(id))return {};}return appendDrawing(base,coordinateSource(id,QStringLiteral("%1,%2,%3").arg(number(v[0]),number(v[1]),number(v[2])),true));}
QString sphere(const Scene &scene,int center,double radius){if(!scene.valid||!scene.coordinateSafe||center<0||center>=scene.items.size()||!std::isfinite(radius)||radius<=0||radius>100)return {};bool centerOk=false;spatialPosition(scene,center,&centerOk);if(!centerOk)return {};const auto &p=scene.items[center];if((p.kind!=Kind::Point&&p.kind!=Kind::Node)||!p.located||p.id.startsWith(QLatin1Char('#')))return {};return appendDrawing(scene,QStringLiteral("\\draw (%1) circle (%2cm);").arg(p.id,number(radius*scene.spaceUnit)));}

bool isSphere(const Scene &scene,int index){if(index<0||index>=scene.items.size())return false;const auto &i=scene.items[index];return i.kind==Kind::Ellipse&&i.shape==QStringLiteral("circle")&&i.spatial&&i.textStart<0&&i.radiusStart>=0;}
static QString reorderedUnchecked(const Scene &scene,int index,bool front){
  if(!scene.valid||scene.partial||index<0||index>=scene.items.size())return {};
  if(scene.items[index].kind==Kind::Point){const auto id=scene.items[index].id;index=-1;for(int n=0;n<scene.items.size();++n)if(scene.items[n].textStart>=0&&scene.items[n].coordinates.value(0).reference==id){index=n;break;}if(index<0)return {};}
  const auto &i=scene.items[index];if(i.kind==Kind::Point||i.kind==Kind::Node||i.clipping)return {};
  // Never move a path across a clip or a coordinate declaration it relies on.
  int at=scene.bodyStart;for(const auto &other:scene.items)if((other.kind==Kind::Point||other.kind==Kind::Node||other.clipping)&&other.end<=i.start)at=qMax(at,other.end);
  if(front){at=scene.bodyEnd;for(const auto &other:scene.items)if(other.clipping&&other.start>i.start)at=qMin(at,other.start);}
  if(at>=i.start&&at<=i.end)return scene.source;
  auto result=scene.source;const auto statement=result.mid(i.start,i.end-i.start);result.remove(i.start,i.end-i.start);if(at>i.end)at-=i.end-i.start;result.insert(at,QLatin1Char('\n')+statement+QLatin1Char('\n'));return result;
}

QString spatialCurve(const Scene &scene,const QStringList &expressions,double from,double to){
  if(!scene.valid||!scene.coordinateSafe||scene.items.size()>450||expressions.size()!=3||!std::isfinite(from)||!std::isfinite(to)||from>=to||qAbs(from)>10000||qAbs(to)>10000)return {};
  QStringList source;for(auto expression:expressions){if(expression.size()>256)return {};expression.replace(QRegularExpression(QStringLiteral(R"((?<![A-Za-z\\])t(?![A-Za-z]))")),QStringLiteral("\\x"));bool ok=false;evaluate(expression,(from+to)/2,&ok);if(!ok)return {};expression.replace(QStringLiteral("\\x"),QStringLiteral("\\t"));source.append(QLatin1Char('{')+expression+QLatin1Char('}'));}
  auto base=scene;if(scene.items.isEmpty()){const auto updated=projectionView(scene,-45,25,4);if(updated.isEmpty())return {};base=parse(updated,scene.styleContext);}return appendDrawing(base,QStringLiteral("\\draw[domain=%1:%2,samples=160,variable=\\t] plot (%3);").arg(number(from),number(to),source.join(QLatin1Char(','))));
}
