    if(label->document()->isModified()){auto value=label->toPlainText();if(mathLabel&&!value.startsWith(QLatin1Char('$')))value=QLatin1Char('$')+value+QLatin1Char('$');if(!stage(QStringLiteral("label"),value,label))return false;}
    if(working.items[selected].kind==Tikz::Kind::Plot)for(auto *field:{expressionX,expression,expressionZ})if(field->isVisibleTo(this)&&field->isModified()){const auto key=field==expressionX?QStringLiteral("expression X"):field==expressionZ?QStringLiteral("expression Z"):QStringLiteral("expression");if(!stage(key,field->text(),field))return false;}
    if(parameterField->isVisibleTo(this)&&parameter->isModified()&&!stage(QStringLiteral("parameter"),parameter->text(),parameter))return false;
    parameter->setModified(false);label->document()->setModified(false);for(auto *field:{expressionX,expression,expressionZ})field->setModified(false);commit(draft);return true;
  }
  void commitGeometry(const QString &draft){if(draft.isEmpty()){inspect();if(canvas->hasQuadratic()){if(canvas->failed)canvas->failed(QStringLiteral("quadraticChanged"));}else if(canvas->hasConic()){if(canvas->failed)canvas->failed(QStringLiteral("conicChanged"));}else if(!canvas->model().intersections.isEmpty()){if(canvas->failed)canvas->failed(QStringLiteral("crossingChanged"));}else ui.notice->setText(words("此改动与已有构造或共用定义冲突。请调整定义对象，或编辑源码。","This change conflicts with a construction or shared definition. Edit its defining objects or Source."));return;}commit(draft);}
  void commit(const QString &draft){if(draft.isEmpty()||draft==history[historyAt])return;while(history.size()>historyAt+1)history.removeLast();history.append(draft);if(history.size()>128)history.removeFirst();historyAt=history.size()-1;parseDraft();}
  void undoDraft(int delta){if(canvas->activeDrag()){canvas->cancelDrag();return;}if(!commitInputs())return;flushSource();canvas->cancelDrag();const int next=historyAt+delta;if(next<0||next>=history.size())return;historyAt=next;parseDraft();if(mode->currentIndex()==1){QSignalBlocker b(source);source->setPlainText(history[historyAt]);}}
  void addObject(const QString &preset,const QPointF &at){if(!commitInputs())return;const int before=canvas->model().items.size();const auto d=Tikz::inserted(canvas->model(),preset,at);if(d.isEmpty())return;commit(d);canvas->choose(before);canvas->fit();canvas->setFocus();}
protected:
  bool eventFilter(QObject *object,QEvent *event)override{if(object==label&&event->type()==QEvent::FocusOut)commitInputs();if(object==source&&event->type()==QEvent::KeyPress){const auto *e=static_cast<QKeyEvent*>(event);if(e->matches(QKeySequence::Undo)||e->matches(QKeySequence::Redo)){undoDraft(e->matches(QKeySequence::Undo)?-1:1);return true;}}return MaterialDialog::eventFilter(object,event);}
  void keyPressEvent(QKeyEvent *e)override{if(e->matches(QKeySequence::Undo)||e->matches(QKeySequence::Redo)){undoDraft(e->matches(QKeySequence::Undo)?-1:1);e->accept();return;}if(e->key()==Qt::Key_Escape&&canvas->activeDrag()){canvas->cancelDrag();e->accept();return;}if(e->key()==Qt::Key_Return||e->key()==Qt::Key_Enter){e->accept();return;}MaterialDialog::keyPressEvent(e);}
  void showEvent(QShowEvent *event)override{MaterialDialog::showEvent(event);canvas->fit();}
  void hideEvent(QHideEvent *event)override{sourceDelay.stop();renderer->invalidate(false);MaterialDialog::hideEvent(event);}
  void resizeEvent(QResizeEvent *event)override{MaterialDialog::resizeEvent(event);if(inspectorScroll)responsive();}
};
void openTikz(TeXDocumentWindow *w,bool insert,const AuthoringSpan &span,const QString &seed,const SourceEdit *inherited){if(!w||w->editor()->isReadOnly())return;if(auto *existing=w->findChild<QDialog*>(QStringLiteral("researchTikzDialog"))){existing->show();existing->raise();return;}(new TikzDialog(w,insert,span,seed,inherited))->show();}
