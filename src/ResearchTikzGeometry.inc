// Deterministic Euclidean construction expressed as ordinary TikZ coordinates.
// Loaded after the source parser; no external service or symbolic runtime.
namespace {
QString appendDrawing(const Scene &scene,const QString &body,const QString &library={}){
  if(!scene.coordinateNodeSafe&&body.contains(QStringLiteral("\\coordinate")))return {};
  QString result=scene.source;if(!library.isEmpty())result.insert(scene.bodyStart,QStringLiteral("\n\\usetikzlibrary{")+library+QStringLiteral("}\n"));const int end=scene.bodyEnd+(result.size()-scene.source.size());result.insert(end,QLatin1Char('\n')+body+QLatin1Char('\n'));return result;
}
QString freshName(const Scene &scene,QSet<QString> &used,bool helper=false){
  if(used.isEmpty())used=occupiedNames(scene);QString name;if(!helper)for(QChar c=QLatin1Char('A');c<=QLatin1Char('Z');c=QChar(c.unicode()+1)){name=QString(c);if(!used.contains(name)){used.insert(name);return name;}}
  int n=1;do{name=QStringLiteral("tl%1%2").arg(helper?QStringLiteral("h"):QString(),QString::number(n++));}while(used.contains(name));used.insert(name);return name;
}
QString coordinateSource(const QString &id,const QString &value,bool visible){auto s=QStringLiteral("\\coordinate (%1) at (%2);\n").arg(id,value);if(visible)s+=QStringLiteral("\\fill (%1) circle (1.2pt) node[above right] {$%1$};\n").arg(id);return s;}
QString throughCircle(const QString &a,const QString &b){return QStringLiteral("\\draw let \\p1=($(%2)-(%1)$) in (%1) circle ({veclen(\\x1,\\y1)});").arg(a,b);}
}
QString pointLabel(const Scene &scene,int index){if(index<0||index>=scene.items.size())return {};const auto &point=scene.items[index];if(point.kind!=Kind::Point)return point.text;for(const auto &i:scene.items)if(i.textStart>=0&&i.coordinates.value(0).reference==point.id)return i.text;return point.id;}
QString construct(const Scene &scene,const QString &tool,const QVector<int> &indices,const QPointF &at,QString *error){
  auto fail=[&](const QString &why){if(error)*error=why;return QString();};if(!scene.valid||!scene.coordinateSafe)return fail(QStringLiteral("source"));if(scene.items.size()>450)return fail(QStringLiteral("limit"));QVector<QPointF> points;QStringList names;QSet<int> seen;
  for(int n:indices){if(n<0||n>=scene.items.size()||seen.contains(n))return fail(QStringLiteral("points"));seen.insert(n);const auto &i=scene.items[n];if((i.kind!=Kind::Node&&i.kind!=Kind::Point)||!i.located||i.id.startsWith(QLatin1Char('#')))return fail(QStringLiteral("points"));points.append(i.position);names.append(i.id);}
  if(QStringList{QStringLiteral("foot"),QStringLiteral("perpendicular"),QStringLiteral("intersection"),QStringLiteral("circleThrough"),QStringLiteral("circumcircle"),QStringLiteral("rightAngle")}.contains(tool))for(int n:indices)if(scene.items[n].spatial)return fail(QStringLiteral("spatial"));
  QSet<QString> used;auto fresh=[&](bool helper=false){return freshName(scene,used,helper);};auto coord=[](const QString &n){return QLatin1Char('(')+n+QLatin1Char(')');};QString body,libs;
  if(tool==QStringLiteral("point")||tool==QStringLiteral("controlPoint")){if(!std::isfinite(at.x())||!std::isfinite(at.y())||qAbs(at.x())>10000||qAbs(at.y())>10000)return fail(QStringLiteral("value"));const auto name=fresh(tool==QStringLiteral("controlPoint"));body=coordinateSource(name,Tikz::number(at.x()/scene.canvasScale.x())+QStringLiteral("cm,")+Tikz::number(at.y()/scene.canvasScale.y())+QStringLiteral("cm"),tool==QStringLiteral("point"));}
  else if(tool==QStringLiteral("segment")||tool==QStringLiteral("polyline")||tool==QStringLiteral("polygon")){if(names.size()<(tool==QStringLiteral("polygon")?3:2)||names.size()>64)return fail(QStringLiteral("points"));body=QStringLiteral("\\draw ")+coord(names[0]);for(int n=1;n<names.size();++n)body+=QStringLiteral(" -- ")+coord(names[n]);if(tool==QStringLiteral("polygon"))body+=QStringLiteral(" -- cycle");body+=QLatin1Char(';');}
  else if(tool==QStringLiteral("line3D")||tool==QStringLiteral("ray3D")||tool==QStringLiteral("vector3D")){
    if(names.size()!=2)return fail(QStringLiteral("points"));bool aok=false,bok=false;const auto a=spatialPosition(scene,indices[0],&aok),b=spatialPosition(scene,indices[1],&bok);if(!aok||!bok)return fail(QStringLiteral("spatialPoints"));double length=0;for(int k=0;k<3;++k)length+=qPow(a[k]-b[k],2);if(length<1e-12)return fail(QStringLiteral("degenerate"));if(tool==QStringLiteral("vector3D"))body=QStringLiteral("\\draw[->] (%1)--(%2);").arg(names[0],names[1]);else{const auto end=fresh(true);body=coordinateSource(end,QStringLiteral("$(%1)!2!(%2)$").arg(names[0],names[1]),false);if(tool==QStringLiteral("ray3D"))body+=QStringLiteral("\\draw[->] (%1)--(%2);").arg(names[0],end);else{const auto begin=fresh(true);body+=coordinateSource(begin,QStringLiteral("$(%1)!-1!(%2)$").arg(names[0],names[1]),false);body+=QStringLiteral("\\draw[<->] (%1)--(%2);").arg(begin,end);}libs=QStringLiteral("calc");}}
  else if(tool==QStringLiteral("plane3D")){
    if(names.size()!=3)return fail(QStringLiteral("points"));QVector<std::array<double,3>> p;for(int n:indices){bool ok=false;const auto v=spatialPosition(scene,n,&ok);if(!ok)return fail(QStringLiteral("spatialPoints"));p.append(v);}std::array<double,3> u,v;for(int k=0;k<3;++k){u[k]=p[1][k]-p[0][k];v[k]=p[2][k]-p[0][k];}const double cross=qPow(u[1]*v[2]-u[2]*v[1],2)+qPow(u[2]*v[0]-u[0]*v[2],2)+qPow(u[0]*v[1]-u[1]*v[0],2);if(cross<1e-12)return fail(QStringLiteral("degenerate"));const auto corner=fresh(true);body=coordinateSource(corner,QStringLiteral("$(%1)+(%2)-(%3)$").arg(names[1],names[2],names[0]),false)+QStringLiteral("\\draw (%1)--(%2)--(%3)--(%4)--cycle;").arg(names[0],names[1],corner,names[2]);libs=QStringLiteral("calc");}
  else if(tool==QStringLiteral("bezier")){if(names.size()!=4)return fail(QStringLiteral("points"));body=QStringLiteral("\\draw (%1) .. controls (%2) and (%3) .. (%4);").arg(names[0],names[1],names[2],names[3]);}
  else if(tool==QStringLiteral("clip")){if(names.size()!=2||qAbs(points[0].x()-points[1].x())<1e-6||qAbs(points[0].y()-points[1].y())<1e-6)return fail(QStringLiteral("degenerate"));const auto a=points[0],b=points[1];auto result=scene.source;result.insert(scene.bodyStart,QStringLiteral("\n\\clip (%1cm,%2cm) rectangle (%3cm,%4cm);\n").arg(number(a.x()/scene.canvasScale.x()),number(a.y()/scene.canvasScale.y()),number(b.x()/scene.canvasScale.x()),number(b.y()/scene.canvasScale.y())));return result;}
  else if(tool==QStringLiteral("midpoint")){if(names.size()!=2)return fail(QStringLiteral("points"));body=coordinateSource(fresh(),QStringLiteral("$(%1)!0.5!(%2)$").arg(names[0],names[1]),true);libs=QStringLiteral("calc");}
  else if(tool==QStringLiteral("foot")){if(names.size()!=3||QLineF(points[1],points[2]).length()<1e-7)return fail(QStringLiteral("degenerate"));body=coordinateSource(fresh(),QStringLiteral("$(%1)!(%2)!(%3)$").arg(names[1],names[0],names[2]),true);libs=QStringLiteral("calc");}
  else if(tool==QStringLiteral("parallel")||tool==QStringLiteral("perpendicular")){if(names.size()!=3||QLineF(points[0],points[1]).length()<1e-7)return fail(QStringLiteral("degenerate"));const auto q=fresh(true);body=coordinateSource(q,tool==QStringLiteral("parallel")?QStringLiteral("$(%1)+(%2)-(%3)$").arg(names[2],names[1],names[0]):QStringLiteral("$(%1)!1!90:($(%1)+(%2)-(%3)$)$").arg(names[2],names[1],names[0]),false);body+=QStringLiteral("\\draw (%1) -- (%2);").arg(names[2],q);libs=QStringLiteral("calc");}
  else if(tool==QStringLiteral("intersection")){if(names.size()!=4)return fail(QStringLiteral("points"));const auto u=points[1]-points[0],v=points[3]-points[2];if(qAbs(u.x()*v.y()-u.y()*v.x())<1e-8)return fail(QStringLiteral("degenerate"));body=coordinateSource(fresh(),QStringLiteral("intersection cs:first line={(%1)--(%2)},second line={(%3)--(%4)}").arg(names[0],names[1],names[2],names[3]),true);}
  else if(tool==QStringLiteral("parallelogram")){if(names.size()!=3)return fail(QStringLiteral("points"));body=coordinateSource(fresh(),QStringLiteral("$(%1)+(%2)-(%3)$").arg(names[1],names[2],names[0]),true);libs=QStringLiteral("calc");}
  else if(tool==QStringLiteral("pyramidFrom")||tool==QStringLiteral("tetrahedron")||tool==QStringLiteral("prismFrom")){const int baseCount=tool==QStringLiteral("tetrahedron")?3:4;if(names.size()!=baseCount+1)return fail(QStringLiteral("points"));auto edge=[&](const QString &a,const QString &b,bool hidden){body+=QStringLiteral("\\draw[%1] (%2)--(%3);\n").arg(hidden?QStringLiteral("dashed"):QStringLiteral("semithick"),a,b);};for(int n=0;n<baseCount;++n)edge(names[n],names[(n+1)%baseCount],n>=2);if(tool==QStringLiteral("prismFrom")){QStringList top{names.last()};for(int n=1;n<baseCount;++n){const auto q=fresh();body+=coordinateSource(q,QStringLiteral("$(%1)+(%2)-(%3)$").arg(names[n],top.first(),names[0]),true);top.append(q);}for(int n=0;n<baseCount;++n){edge(names[n],top[n],n==baseCount-1);edge(top[n],top[(n+1)%baseCount],false);}libs=QStringLiteral("calc");}else for(int n=0;n<baseCount;++n)edge(names[n],names.last(),n==baseCount-1);}
  else if(tool==QStringLiteral("circleThrough")){if(names.size()!=2||QLineF(points[0],points[1]).length()<1e-7)return fail(QStringLiteral("degenerate"));body=throughCircle(names[0],names[1]);libs=QStringLiteral("calc");}
  else if(tool==QStringLiteral("circumcircle")){if(names.size()!=3)return fail(QStringLiteral("points"));const auto u=points[1]-points[0],v=points[2]-points[0];if(qAbs(u.x()*v.y()-u.y()*v.x())<1e-8)return fail(QStringLiteral("degenerate"));const auto m=fresh(true),n=fresh(true),p=fresh(true),q=fresh(true),o=fresh(true);body=coordinateSource(m,QStringLiteral("$(%1)!0.5!(%2)$").arg(names[0],names[1]),false)+coordinateSource(n,QStringLiteral("$(%1)!0.5!(%2)$").arg(names[0],names[2]),false)+coordinateSource(p,QStringLiteral("$(%1)!1!90:($(%1)+(%2)-(%3)$)$").arg(m,names[1],names[0]),false)+coordinateSource(q,QStringLiteral("$(%1)!1!90:($(%1)+(%2)-(%3)$)$").arg(n,names[2],names[0]),false)+coordinateSource(o,QStringLiteral("intersection cs:first line={(%1)--(%2)},second line={(%3)--(%4)}").arg(m,p,n,q),false)+throughCircle(o,names[0]);libs=QStringLiteral("calc");}
  else if(tool==QStringLiteral("angle")||tool==QStringLiteral("rightAngle")||tool==QStringLiteral("projectedRightAngle")){if(names.size()!=3||QLineF(points[0],points[1]).length()<1e-7||QLineF(points[2],points[1]).length()<1e-7)return fail(QStringLiteral("degenerate"));const bool right=tool!=QStringLiteral("angle");if(right&&tool!=QStringLiteral("projectedRightAngle")){const auto u=points[0]-points[1],v=points[2]-points[1];if(qAbs(QPointF::dotProduct(u,v))>1e-5*std::hypot(u.x(),u.y())*std::hypot(v.x(),v.y()))return fail(QStringLiteral("rightAngle"));}if(!right){const auto u=points[0]-points[1],v=points[2]-points[1];if(u.x()*v.y()-u.y()*v.x()<0)names.swapItemsAt(0,2);}body=QStringLiteral("\\pic[draw,angle radius=%1cm%2] {%3=%4--%5--%6};").arg(right?QStringLiteral(".22"):QStringLiteral(".35"),right?QString():QStringLiteral(",pic text={$\\alpha$}"),right?QStringLiteral("right angle"):QStringLiteral("angle"),names[0],names[1],names[2]);libs=QStringLiteral("angles");}
  else return fail(QStringLiteral("tool"));return appendDrawing(scene,body,libs);
}

QString triangle(const Scene &scene,int mode,const QVector<double> &values,const QPointF &at,QString *error){auto fail=[&]{if(error)*error=QStringLiteral("triangle");return QString();};if(!scene.valid||!scene.coordinateSafe||values.size()!=3||mode<0||mode>2)return fail();for(double n:values)if(!std::isfinite(n)||n<=0||n>1000)return fail();const double c=values[0];double x=0,y=0;if(mode==0){const double b=values[1],a=values[2];if(a+b<=c||a+c<=b||b+c<=a)return fail();x=(b*b+c*c-a*a)/(2*c);y=std::sqrt(qMax(0.,b*b-x*x));}else{double b=values[1],angle=values[2];if(mode==2){const double aa=values[1],bb=values[2];if(aa+bb>=180)return fail();angle=aa;b=c*std::sin(qDegreesToRadians(bb))/std::sin(qDegreesToRadians(aa+bb));}if(angle<=0||angle>=180)return fail();x=b*std::cos(qDegreesToRadians(angle));y=b*std::sin(qDegreesToRadians(angle));}if(y<1e-6)return fail();const QVector<QPointF> p{{-c/2,-y/2},{c/2,-y/2},{x-c/2,y/2}};QSet<QString> used;QStringList names;QString body;for(const auto &v:p){const auto name=freshName(scene,used);names.append(name);const auto q=v+at;body+=coordinateSource(name,number(q.x()/scene.canvasScale.x())+QStringLiteral("cm,")+number(q.y()/scene.canvasScale.y())+QStringLiteral("cm"),true);}body+=QStringLiteral("\\draw (%1)--(%2)--(%3)--cycle;").arg(names[0],names[1],names[2]);return appendDrawing(scene,body);}

QString clipped(const Scene &scene,const QRectF &bounds){const auto r=bounds.normalized();if(!scene.valid||!scene.coordinateSafe||r.width()<.01||r.height()<.01||!std::isfinite(r.left())||!std::isfinite(r.right())||!std::isfinite(r.top())||!std::isfinite(r.bottom()))return {};auto result=scene.source;result.insert(scene.bodyStart,QStringLiteral("\n\\clip (%1cm,%2cm) rectangle (%3cm,%4cm);\n").arg(number(r.left()/scene.canvasScale.x()),number(r.top()/scene.canvasScale.y()),number(r.right()/scene.canvasScale.x()),number(r.bottom()/scene.canvasScale.y())));return result;}
