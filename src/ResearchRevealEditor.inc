    p->save();p->setRenderHint(QPainter::Antialiasing);const auto rect=QRectF(o.rect).adjusted(0,2,0,-2);if(o.state&QStyle::State_Selected){p->setPen(Qt::NoPen);p->setBrush(QColor(QStringLiteral("#edf2f5")));p->drawRoundedRect(rect,4,4);}
    p->setFont(interfaceFont());p->setPen(QColor(QStringLiteral("#30363c")));const auto content=index.data().toString();p->drawText(rect.adjusted(12,9,-12,-34),Qt::AlignVCenter,p->fontMetrics().elidedText(content,Qt::ElideRight,qRound(rect.width())-24));
    p->setPen(QColor(QStringLiteral("#687780")));p->drawText(rect.adjusted(12,39,-12,-10),Qt::AlignVCenter,index.data(Qt::UserRole+1).toString());p->restore();
