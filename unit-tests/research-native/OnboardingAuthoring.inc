// Record genuine research materials through actual on-demand editing tools.
static void recordAuthoring(const QString &folder,const QString &language,
    const std::function<void(QString,bool)> &check,const std::function<void(QWidget *,QSize)> &place) {
  const QString figurePath=folder+"/bronze-mirror.tex",tablePath=folder+"/penguin-morphology.tex",citationPath=folder+"/common-pool-resources.tex";
  const auto figureBefore=bytes(figurePath),tableBefore=bytes(tablePath),citationBefore=bytes(citationPath),bibBefore=bytes(folder+"/commons-literature.bib");
  check(language+": genuine material files have been staged",!figureBefore.isEmpty()&&!tableBefore.isEmpty()&&!citationBefore.isEmpty()&&!bibBefore.isEmpty());
  auto *w=new TeXDocumentWindow(figurePath);place(w,QSize(1280,800));
  auto select=[&](TeXDocumentWindow *target,const QString &token){auto cursor=target->textCursor();const int at=target->textDoc()->editorText().indexOf(token);check(language+": locate actual source "+token,at>=0);cursor.setPosition(at+3);target->editor()->setTextCursor(cursor);target->editor()->ensureCursorVisible();settle(180);};
  select(w,"\\includegraphics");Recording rec;rec.start(QDir(folder+"/../..").absolutePath()+"/tools-"+language,w);
  auto openObject=[&](TeXDocumentWindow *target){check(language+": open the visible Edit figure or table menu",rec.chooseNested(target->findChild<QToolButton *>("researchMore"),target->findChild<QMenu *>("researchEditMenu"),target->findChild<QAction *>("researchEditObject")));auto *dialog=target->findChild<QDialog *>("researchObjectDialog");check(language+": real object dialog fits the complete window",dialog&&rec.contains(dialog));return QPointer<QDialog>(dialog);};
  auto ready=[&](QDialog *dialog,const QString &expected){return waitFor([&]{auto *code=dialog?dialog->findChild<QPlainTextEdit *>("researchObjectSource"):nullptr;auto *image=dialog?dialog->findChild<QLabel *>("researchObjectPreview"):nullptr;return code&&code->toPlainText().contains(expected)&&image&&image->property("researchDraftReady").toBool();},45000);};
  rec.action("Prepare a catalogue illustration of The Met's Etruscan mirror 22.139.84");auto dialog=openObject(w);check(language+": actual museum image preview is ready",ready(dialog,"met-bronze-mirror-22-139-84.jpg"));settle(850);
  auto *preview=dialog->findChild<QLabel *>("researchObjectPreview");auto *form=dialog->findChild<QWidget *>("researchObjectForm");
  check(language+": the figure preview stays left of its properties",preview->mapToGlobal(QPoint()).x()<form->mapToGlobal(QPoint()).x());
  check(language+": a hidden table container cannot cover the figure header",!dialog->findChild<QWidget *>("researchTableMeta")->isVisible());
  rec.action("Adjust the plate width and retain the verified accession and credit line");auto *width=dialog->findChild<QDoubleSpinBox *>("researchFigureWidth");rec.click(width);key(width,Qt::Key_A,Qt::ControlModifier);type(width,"55",130);key(width,Qt::Key_Tab);check(language+": width entry commits without closing the draft",dialog&&dialog->isVisible());
  auto *caption=dialog->findChild<QPlainTextEdit *>("researchObjectCaption");rec.click(caption);key(caption,Qt::Key_End,Qt::ControlModifier);type(caption," Rogers Fund, 1922.",40);
  check(language+": updated credit and width have a current real preview",ready(dialog,"Rogers Fund, 1922.")&&dialog->findChild<QPlainTextEdit *>("researchObjectSource")->toPlainText().contains("0.55\\linewidth"));settle(1300);
  rec.click(dialog->findChild<QToolButton *>("researchObjectSourceTab"));settle(850);check(language+": exact image source remains editable beside its preview",dialog->findChild<QPlainTextEdit *>("researchObjectSource")->isVisible()&&preview->isVisible());
  rec.click(dialog->findChild<QDialogButtonBox *>("researchObjectButtons")->button(QDialogButtonBox::Apply));check(language+": plate edits enter the actual manuscript",w->textDoc()->editorText().contains("Rogers Fund, 1922."));
  auto *tableWindow=new TeXDocumentWindow(tablePath);place(tableWindow,QSize(1280,800));w->hide();rec.follow(tableWindow);select(tableWindow,"\\begin{tabular}");
  rec.action("Round the recomputed Palmer penguin mean to three decimals without changing the observations");dialog=openObject(tableWindow);check(language+": public observation summary preview is ready",ready(dialog,"3.70066"));
  auto *grid=dialog->findChild<QTableWidget *>("researchTableGrid");check(language+": genuine groups units and counts appear in the grid",grid&&grid->rowCount()==4&&grid->columnCount()==4&&grid->item(1,0)->text()=="Adelie"&&grid->item(1,1)->text()=="151");
  rec.clickAt(grid->viewport(),grid->visualItemRect(grid->item(1,2)).center());grid->editItem(grid->item(1,2));settle(100);auto *cell=grid->findChild<QLineEdit *>();check(language+": actual mass cell editor is open",cell);key(cell,Qt::Key_A,Qt::ControlModifier);type(cell,"3.701",100);key(cell,Qt::Key_Return);
  check(language+": rounded source and new actual preview are both complete",ready(dialog,"3.701"));rec.action("Read the rounded mean with its original unit precision and group rules");settle(1500);rec.click(dialog->findChild<QDialogButtonBox *>("researchObjectButtons")->button(QDialogButtonBox::Apply));
  auto tableExpected=QString::fromUtf8(tableBefore);tableExpected.replace("3.70066","3.701");check(language+": rounding preserves every other table byte and horizontal rule",tableWindow->textDoc()->editorText()==tableExpected);
  auto *citationWindow=new TeXDocumentWindow(citationPath);place(citationWindow,QSize(1280,800));tableWindow->hide();rec.follow(citationWindow);
  auto citationCursor=citationWindow->textDoc()->find("\\citep{ostrom2009}");check(language+": existing genuine citation is available for a page-specific revision",!citationCursor.isNull());citationWindow->editor()->setTextCursor(citationCursor);rec.aim(citationWindow->editor()->viewport(),citationWindow->editor()->cursorRect().center());key(citationWindow->editor(),Qt::Key_Delete);
  const QString beforeCitationInsert=citationWindow->textDoc()->editorText();
  rec.action("Support the institutional argument with Ostrom 2009 page 419");
  check(language+": actual citation insertion menu is visible",rec.choosePath(citationWindow->findChild<QToolButton *>("researchMore"),{citationWindow->findChild<QMenu *>("researchEditMenu"),citationWindow->findChild<QMenu *>("researchInsertMenu")},citationWindow->findChild<QAction *>("researchInsertCitation")));
  dialog=citationWindow->findChild<QDialog *>("researchCitationDialog");check(language+": bibliography list and details fit the complete window",dialog&&rec.contains(dialog));auto *list=dialog->findChild<QListWidget *>("researchCitationList");check(language+": both verified Ostrom publications load locally",waitFor([&]{return list&&list->count()==2;}));
  auto *style=dialog->findChild<QComboBox *>("researchCitationStyle");check(language+": secondary citation options start hidden",style&&!style->isVisible());
  int chosen=-1;for(int i=0;i<list->count();++i)if(list->item(i)->data(Qt::UserRole).toString()=="ostrom2009")chosen=i;check(language+": verified 2009 article is available",chosen>=0);rec.clickAt(list->viewport(),list->visualItemRect(list->item(chosen)).center());
  auto *search=dialog->findChild<QLineEdit *>("researchCitationSearch");rec.click(search);type(search,"Ostrom",80);settle(500);auto *locator=dialog->findChild<QLineEdit *>("researchCitationLocator");rec.click(locator);type(locator,"419",150);
  check(language+": searching and page input preserve the chosen publication",list->currentItem()&&list->currentItem()->data(Qt::UserRole).toString()=="ostrom2009");check(language+": the exact supported page locator is shown",dialog->findChild<QLabel *>("researchCitationInsertion")->text()=="\\citep[419]{ostrom2009}");settle(1000);
  rec.click(dialog->findChild<QToolButton *>("researchCitationMore"));check(language+": extra options open only on request",style->isVisible());settle(500);rec.click(dialog->findChild<QToolButton *>("researchCitationMore"));settle(400);rec.click(dialog->findChild<QDialogButtonBox *>("researchCitationButtons")->button(QDialogButtonBox::Ok));check(language+": actual citation enters the argument",citationWindow->textDoc()->editorText().contains("\\citep[419]{ostrom2009}"));settle(800);
  rec.finish();check(language+": research tools recording contains valid actual inputs",rec.failures==0);
  citationWindow->editor()->undo();check(language+": citation insertion is one undo step",citationWindow->textDoc()->editorText()==beforeCitationInsert);citationWindow->editor()->undo();tableWindow->editor()->undo();w->editor()->undo();check(language+": each tool edit is independently reversible",citationWindow->textDoc()->editorText()==QString::fromUtf8(citationBefore)&&tableWindow->textDoc()->editorText()==QString::fromUtf8(tableBefore)&&w->textDoc()->editorText()==QString::fromUtf8(figureBefore));
  check(language+": genuine sources and bibliography on disk remain untouched",bytes(figurePath)==figureBefore&&bytes(tablePath)==tableBefore&&bytes(citationPath)==citationBefore&&bytes(folder+"/commons-literature.bib")==bibBefore);
  for(auto *target:{citationWindow,tableWindow,w}){target->setModified(false);delete target;}
}
