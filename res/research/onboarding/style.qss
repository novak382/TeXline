/* Scoped to the introduction; no editor or PDF styles are changed. */
QDialog#researchOnboarding { background: #f5f5f7; }
QDialog#researchOnboarding QLabel { background: transparent; border: none; }
QDialog#researchOnboarding QLabel#onboardingBrand { color: #6e6e73; font-size: 14px; font-weight: 500; }
QDialog#researchOnboarding QLabel#onboardingTitle { color: #1d1d1f; font-size: 26px; font-weight: 600; }
QDialog#researchOnboarding QLabel#onboardingBody { color: #6e6e73; font-size: 16px; }
QDialog#researchOnboarding QFrame#onboardingMedia { background: #ffffff; border: 1px solid #dedee3; border-radius: 6px; }
QDialog#researchOnboarding QPushButton { font-size: 14px; border-radius: 5px; padding: 0px 14px; min-height: 30px; max-height: 30px; border: 1px solid transparent; background: transparent; color: #6e6e73; }
QDialog#researchOnboarding QPushButton:hover { background: #e9e9ed; color: #1d1d1f; }
QDialog#researchOnboarding QPushButton:focus { border: 1px solid #8d98a8; }
QDialog#researchOnboarding QPushButton#onboardingNext { background: #edf4f7; border: 1px solid #b9cbd5; color: #243b48; font-weight: 500; min-width: 78px; }
QDialog#researchOnboarding QPushButton#onboardingNext:hover { background: #e3edf3; }
QDialog#researchOnboarding QPushButton#onboardingNext:pressed { background: #d8e6ee; }
QDialog#researchOnboarding QPushButton#onboardingClose { padding: 0px; min-height: 30px; max-height: 30px; min-width: 30px; max-width: 30px; }
QDialog#researchOnboarding QPushButton#onboardingPlayback { font-size: 12px; padding: 2px 6px; min-height: 20px; }
QDialog#researchOnboarding QPushButton[onboardingLanguage="true"] { background: #ffffff; border: 1px solid #d2d2d7; font-size: 15px; padding: 0px 12px; min-width: 0px; min-height: 44px; max-height: 44px; }
QDialog#researchOnboarding QPushButton[onboardingLanguage="true"]:hover { border-color: #8d98a8; background: #ededf0; }
QDialog#researchOnboarding QToolButton[onboardingDot="true"] { background: #d2d2d7; border: 2px solid #f5f5f7; border-radius: 6px; padding: 0px; min-width: 8px; max-width: 8px; min-height: 8px; max-height: 8px; }
QDialog#researchOnboarding QToolButton[onboardingDot="true"]:checked { background: #3a3a3c; }
QDialog#researchOnboarding QToolButton[onboardingDot="true"]:focus { border-color: #8d98a8; }
